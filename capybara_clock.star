"""
Applet: Weather-Reactive Capybara Clock
Summary: Full-screen Day & Night Lumei & Lulu weather storyboards + minimal corner clock
Description: Displays an ultra-compact Time + Temp overlay in the upper-left corner over full-screen 64x32 15-second seamlessly looping Day & Night animations of Lumei and Lulu for every Open-Meteo WMO weather condition, switching automatically based on today's local sunrise & sunset.
Author: Capybara Clock
"""

load("cache.star", "cache")
load("encoding/base64.star", "base64")
load("encoding/json.star", "json")
load("http.star", "http")
load("render.star", "render")
load("schema.star", "schema")
load("time.star", "time")

# ---------------------------------------------------------------------------
# Configuration Defaults & Constants
# ---------------------------------------------------------------------------
DEFAULT_LAT = "40.6782"       # Brooklyn, NY
DEFAULT_LON = "-73.9442"
DEFAULT_TIMEZONE = "America/New_York"
DEFAULT_TEMP_UNIT = "F"

# Open-Meteo caching (12 minutes = 720s, within 10-15 min target)
WEATHER_CACHE_TTL_SECONDS = 720
GEOCODE_CACHE_TTL_SECONDS = 86400

# Wind speed threshold (km/h) to trigger "windy" when dry
WINDY_THRESHOLD_KMH = 25.0

# Temperature threshold (°F) below which clear & partly_cloudy switch to cold-weather
# variants (hot cocoa, crackling campfire, knit scarves & steaming buns instead of ice cream)
COLD_THRESHOLD_F = 55.0
TEMP_AWARE_WEATHERS = ("clear", "partly_cloudy")

# Temperature accent colors per weather category / holiday for the tiny upper-left HUD
HUD_TEMP_COLORS = {
    "clear": "#FDE047",
    "partly_cloudy": "#FCD34D",
    "overcast": "#CBD5E1",
    "fog": "#E2E8F0",
    "drizzle": "#93C5FD",
    "freezing_rain": "#67E8F9",
    "rain": "#60A5FA",
    "rain_showers": "#7DD3FC",
    "snow": "#E0F2FE",
    "thunderstorm": "#FDE047",
    "thunderstorm_hail": "#BAE6FD",
    "windy": "#FDBA74",
    # Special holidays & birthdays
    "holiday_new_year": "#FDE047",
    "holiday_lunar_new_year": "#FCD34D",
    "holiday_valentines": "#F9A8D4",
    "birthday_lulu": "#FDBA74",
    "holiday_st_patricks": "#86EFAC",
    "holiday_easter": "#FEF08A",
    "holiday_independence": "#93C5FD",
    "birthday_lumei": "#F9A8D4",
    "holiday_halloween": "#FB923C",
    "holiday_thanksgiving": "#FDBA74",
    "holiday_christmas": "#FDE047",
}

# Exact Lunar New Year dates (2025-2040)
LUNAR_NEW_YEAR_DATES = {
    2025: (1, 29),
    2026: (2, 17),
    2027: (2, 6),
    2028: (1, 26),
    2029: (2, 13),
    2030: (2, 3),
    2031: (1, 23),
    2032: (2, 11),
    2033: (1, 31),
    2034: (2, 19),
    2035: (2, 8),
    2036: (1, 28),
    2037: (2, 15),
    2038: (2, 4),
    2039: (1, 24),
    2040: (2, 12),
}

# ---------------------------------------------------------------------------
# Embedded 64x32 Day & Night 15-Second Seamless GIFs (24 states, 150f @ 100ms)
# Auto-updated by `python3 scripts/generate_sprites.py`
# ---------------------------------------------------------------------------
# --- BEGIN GENERATED SPRITES (DO NOT EDIT MANUALLY) ---
SPRITE_WIDTH = 64
SPRITE_HEIGHT = 32
SPRITE_FRAME_COUNT = 150
SPRITE_DELAY_MS = 100
SPRITES_B64 = {
    "clear_day_warm": "",
    "clear_day_cold": "",
    "clear_night_warm": "",
    "clear_night_cold": "",
    "partly_cloudy_day_warm": "",
    "partly_cloudy_day_cold": "",
    "partly_cloudy_night_warm": "",
    "partly_cloudy_night_cold": "",
