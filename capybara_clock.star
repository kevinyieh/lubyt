"""
Applet: Weather-Reactive Capybara Clock
Summary: Live clock + weather-reactive Lulu & Lumei capybaras
Description: Displays the current time, day of week, and live Open-Meteo temperature alongside 15-second seamlessly looping animations of capybaras Lulu and Lumei reacting to local weather.
Author: Capybara Clock
"""

load("cache.star", "cache")
load("encoding/base64.star", "base64")
load("encoding/json.star", "json")
load("http.star", "http")
load("render.star", "render")
load("schema.star", "schema")
load("time.star", "time")

# ---------------------------------------------------------------------------
# Configuration Defaults & Constants
# ---------------------------------------------------------------------------
DEFAULT_LAT = "40.6782"       # Brooklyn, NY
DEFAULT_LON = "-73.9442"
DEFAULT_TIMEZONE = "America/New_York"
DEFAULT_TEMP_UNIT = "F"

# Open-Meteo caching (12 minutes = 720s, within 10-15 min target)
WEATHER_CACHE_TTL_SECONDS = 720
GEOCODE_CACHE_TTL_SECONDS = 86400

# Wind speed threshold (km/h) to trigger the "windy" animation when not raining/snowing/storming
WINDY_THRESHOLD_KMH = 25.0

# Theme accents per weather state for the left-half clock panel
WEATHER_THEMES = {
    "sunny": {
        "bg": "#0B1B38",
        "divider": "#1D3B6E",
        "day": "#FDE68A",
        "time": "#FFFFFF",
        "temp": "#FBBF24",
        "label": "#93C5FD",
        "default_label": "SUNNY",
    },
    "rainy": {
        "bg": "#080F1E",
        "divider": "#1E3A5F",
        "day": "#93C5FD",
        "time": "#FFFFFF",
        "temp": "#60A5FA",
        "label": "#BAE6FD",
        "default_label": "RAINY",
    },
    "snowy": {
        "bg": "#091326",
        "divider": "#26466D",
        "day": "#BAE6FD",
        "time": "#FFFFFF",
        "temp": "#E0F2FE",
        "label": "#7DD3FC",
        "default_label": "SNOWY",
    },
    "windy": {
        "bg": "#0A1722",
        "divider": "#23495C",
        "day": "#FDBA74",
        "time": "#FFFFFF",
        "temp": "#67E8F9",
        "label": "#A5F3FC",
        "default_label": "WINDY",
    },
    "thunderstorm": {
        "bg": "#060914",
        "divider": "#3B2F63",
        "day": "#DDD6FE",
        "time": "#FFFFFF",
        "temp": "#FDE047",
        "label": "#C4B5FD",
        "default_label": "STORM",
    },
    "default": {
        "bg": "#070D1C",
        "divider": "#1D2C4D",
        "day": "#FDE68A",
        "time": "#FFFFFF",
        "temp": "#FCA5A5",
        "label": "#CBD5E1",
        "default_label": "CLOUDY",
    },
}

# ---------------------------------------------------------------------------
# Embedded 32x32 15-Second Seamless Animated GIF Sprites (150 frames @ 100ms)
# Auto-updated by `python3 scripts/generate_sprites.py`
# ---------------------------------------------------------------------------
# --- BEGIN GENERATED SPRITES (DO NOT EDIT MANUALLY) ---
SPRITE_FRAME_COUNT = 150
SPRITE_DELAY_MS = 100
SPRITES_B64 = {
    "sunny": "",
    "rainy": "",
    "snowy": "",
    "windy": "",
    "thunderstorm": "",
    "default": "",
}
# --- END GENERATED SPRITES ---


# ---------------------------------------------------------------------------
# Helper Functions
# ---------------------------------------------------------------------------
def round_int(val):
    """Pure Starlark nearest-integer rounding (handles positive & negative floats)."""
    if val >= 0:
        return int(val + 0.5)
    return int(val - 0.5)


def geocode_zip(zip_code):
    """
    Resolve a zip/postal code to (lat, lon, timezone) via Open-Meteo's free
    Geocoding API, cached for 24 hours.
    """
    cleaned = zip_code.strip()
    if not cleaned:
        return None

    cache_key = "capybara_geo_" + cleaned.replace(" ", "_")
    cached = cache.get(cache_key)
    if cached != None:
        return json.decode(cached)

    url = (
        "https://geocoding-api.open-meteo.com/v1/search"
        + "?name=" + cleaned.replace(" ", "%20")
        + "&count=1&language=en&format=json"
    )
    resp = http.get(url, ttl_seconds = GEOCODE_CACHE_TTL_SECONDS)
    if resp.status_code != 200:
        return None

    body = resp.json()
    results = body.get("results")
    if not results or len(results) == 0:
        return None

    first = results[0]
    geo = {
        "lat": str(first.get("latitude", DEFAULT_LAT)),
        "lon": str(first.get("longitude", DEFAULT_LON)),
        "timezone": str(first.get("timezone", "")),
    }
    cache.set(cache_key, json.encode(geo), ttl_seconds = GEOCODE_CACHE_TTL_SECONDS)
    return geo


def resolve_location(config):
    """
    Resolve (lat, lon, timezone) with clear precedence:
      1. Explicit `latitude` + `longitude` text config fields
      2. Explicit `zip_code` text field (resolved via Open-Meteo Geocoding API)
      3. Tidbyt `location` schema picker JSON (`lat`, `lng`, `timezone`)
      4. Default fallback (Brooklyn, NY)
    """
    lat = (config.str("latitude") or "").strip()
    lon = (config.str("longitude") or "").strip()
    tz_override = (config.str("timezone") or "").strip()
    tz_from_loc = ""

    if not lat or not lon:
        zip_code = (config.str("zip_code") or "").strip()
        if zip_code:
            geo = geocode_zip(zip_code)
            if geo != None:
                lat = geo.get("lat", DEFAULT_LAT)
                lon = geo.get("lon", DEFAULT_LON)
                tz_from_loc = geo.get("timezone", "")

    if not lat or not lon:
        loc_raw = config.get("location")
        if loc_raw:
            loc = json.decode(loc_raw)
            if loc:
                lat = str(loc.get("lat", DEFAULT_LAT))
                lon = str(loc.get("lng", DEFAULT_LON))
                tz_from_loc = str(loc.get("timezone", ""))

    if not lat or not lon:
        lat = DEFAULT_LAT
        lon = DEFAULT_LON

    timezone = tz_override or tz_from_loc or config.get("$tz") or DEFAULT_TIMEZONE
    return lat, lon, timezone


def map_wmo_to_weather(wmo_code, wind_kmh, is_day):
    """
    Map Open-Meteo WMO weather code + wind speed + day/night flag into:
      (animation_state, short_label)
    """
    code = int(wmo_code)

    # Thunderstorm (95, 96, 99)
    if code in (95, 96, 99):
        return "thunderstorm", "STORM"

    # Snow (71, 73, 75, 77, 85, 86)
    if code in (71, 73, 75, 77, 85, 86):
        return "snowy", "SNOWY"

    # Rain & Drizzle (51-57, 61-67, 80-82)
    if code in (51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82):
        return "rainy", "RAINY"

    # Windy override when winds are brisk and precipitation isn't active
    if wind_kmh >= WINDY_THRESHOLD_KMH:
        return "windy", "WINDY"

    # Clear / Mainly Clear (0, 1)
    if code in (0, 1):
        if int(is_day) == 1:
            return "sunny", "SUNNY"
        return "default", "CLEAR"

    # Fog (45, 48)
    if code in (45, 48):
        return "default", "FOGGY"

    # Partly Cloudy / Overcast (2, 3)
    if code in (2, 3):
        return "default", "CLOUDY"

    return "default", "MILD"


def fetch_weather(lat, lon, temp_unit):
    """
    Fetch current temperature, WMO weather code, wind speed, and is_day
    from the free Open-Meteo Forecast API with 12-minute cache.set/cache.get.
    """
    unit_param = "celsius" if temp_unit == "C" else "fahrenheit"
    # Round cache key coordinates lightly for high hit rates
    cache_key = "capybara_wx_%s_%s_%s" % (lat, lon, temp_unit)

    cached_raw = cache.get(cache_key)
    if cached_raw != None:
        return json.decode(cached_raw)

    url = (
        "https://api.open-meteo.com/v1/forecast"
        + "?latitude=" + lat
        + "&longitude=" + lon
        + "&current=temperature_2m,weather_code,wind_speed_10m,is_day"
        + "&temperature_unit=" + unit_param
    )

    resp = http.get(url, ttl_seconds = WEATHER_CACHE_TTL_SECONDS)
    if resp.status_code != 200:
        return None

    data = resp.json()
    current = data.get("current")
    if not current:
        return None

    weather = {
        "temp": current.get("temperature_2m", 0.0),
        "code": current.get("weather_code", 2),
        "wind": current.get("wind_speed_10m", 0.0),
        "is_day": current.get("is_day", 1),
    }
    cache.set(cache_key, json.encode(weather), ttl_seconds = WEATHER_CACHE_TTL_SECONDS)
    return weather


# ---------------------------------------------------------------------------
# Main Render Entrypoint
# ---------------------------------------------------------------------------
def main(config):
    lat, lon, timezone = resolve_location(config)
    use_24h = config.bool("use_24h", False)
    temp_unit = config.str("temp_unit", DEFAULT_TEMP_UNIT)
    debug_weather = config.str("debug_weather", "auto")

    # Current local time
    now = time.now().in_location(timezone)
    day_str = now.format("Mon").upper()
    if use_24h:
        time_str = now.format("15:04")
        header_str = day_str
    else:
        time_str = now.format("3:04")
        ampm = now.format("PM")
        header_str = day_str + " " + ampm

    # Live weather fetch (with cache.get/cache.set)
    weather = fetch_weather(lat, lon, temp_unit)
    unit_suffix = "°C" if temp_unit == "C" else "°F"

    if weather != None:
        temp_str = "%d%s" % (round_int(weather["temp"]), unit_suffix)
        state, label_str = map_wmo_to_weather(
            weather["code"],
            weather["wind"],
            weather["is_day"],
        )
    else:
        temp_str = "--" + unit_suffix
        state = "default"
        label_str = "MILD"

    # Debug override dropdown for easy local testing of any animation state
    if debug_weather != "auto" and debug_weather in SPRITES_B64:
        state = debug_weather
        label_str = WEATHER_THEMES[state]["default_label"]

    theme = WEATHER_THEMES.get(state, WEATHER_THEMES["default"])
    sprite_bytes = base64.decode(SPRITES_B64[state])

    # Left Half (31px content + 1px subtle divider = 32px wide x 32px tall)
    left_panel = render.Box(
        width = 31,
        height = 32,
        color = theme["bg"],
        child = render.Column(
            expanded = True,
            main_align = "space_evenly",
            cross_align = "center",
            children = [
                render.Text(
                    content = header_str,
                    font = "CG-pixel-3x5-mono",
                    color = theme["day"],
                ),
                render.Text(
                    content = time_str,
                    font = "6x13",
                    color = theme["time"],
                ),
                render.Text(
                    content = temp_str,
                    font = "5x8",
                    color = theme["temp"],
                ),
                render.Text(
                    content = label_str,
                    font = "CG-pixel-3x5-mono",
                    color = theme["label"],
                ),
            ],
        ),
    )

    divider = render.Box(
        width = 1,
        height = 32,
        color = theme["divider"],
    )

    # Right Half (32x32 seamlessly looping 15-second capybara animation)
    right_panel = render.Box(
        width = 32,
        height = 32,
        color = theme["bg"],
        child = render.Image(
            src = sprite_bytes,
            width = 32,
            height = 32,
        ),
    )

    return render.Root(
        delay = SPRITE_DELAY_MS,
        show_full_animation = True,
        max_age = 300,
        child = render.Row(
            expanded = True,
            children = [
                left_panel,
                divider,
                right_panel,
            ],
        ),
    )


# ---------------------------------------------------------------------------
# Pixlet Configuration Schema
# ---------------------------------------------------------------------------
def get_schema():
    temp_unit_options = [
        schema.Option(display = "Fahrenheit (°F)", value = "F"),
        schema.Option(display = "Celsius (°C)", value = "C"),
    ]

    debug_weather_options = [
        schema.Option(display = "Auto (Live Weather)", value = "auto"),
        schema.Option(display = "Sunny (Shades & Watermelon)", value = "sunny"),
        schema.Option(display = "Rainy (Blue Umbrella)", value = "rainy"),
        schema.Option(display = "Snowy (Scarves & Snow)", value = "snowy"),
        schema.Option(display = "Windy (Swirling Leaves)", value = "windy"),
        schema.Option(display = "Thunderstorm (Blanket & Lightning)", value = "thunderstorm"),
        schema.Option(display = "Default (Starry Idle)", value = "default"),
    ]

    return schema.Schema(
        version = "1",
        fields = [
            schema.Location(
                id = "location",
                name = "Location",
                desc = "Select your city for live local weather and timezone.",
                icon = "locationDot",
            ),
            schema.Text(
                id = "latitude",
                name = "Latitude (Optional Override)",
                desc = "Manual latitude (e.g., 40.6782). Overrides Location picker when paired with Longitude.",
                icon = "compass",
            ),
            schema.Text(
                id = "longitude",
                name = "Longitude (Optional Override)",
                desc = "Manual longitude (e.g., -73.9442). Overrides Location picker when paired with Latitude.",
                icon = "compass",
            ),
            schema.Text(
                id = "zip_code",
                name = "Zip / Postal Code (Optional)",
                desc = "Alternative to Lat/Lon (e.g., 11215). Resolved via Open-Meteo Geocoding.",
                icon = "mapPin",
            ),
            schema.Text(
                id = "timezone",
                name = "Timezone (Optional Override)",
                desc = "IANA timezone name (e.g., America/New_York, America/Los_Angeles).",
                icon = "clock",
            ),
            schema.Toggle(
                id = "use_24h",
                name = "24-Hour Clock",
                desc = "Display time in 24-hour format (HH:MM) instead of 12-hour format.",
                icon = "clock",
                default = False,
            ),
            schema.Dropdown(
                id = "temp_unit",
                name = "Temperature Unit",
                desc = "Display temperature in Fahrenheit (°F) or Celsius (°C).",
                icon = "temperatureHalf",
                default = temp_unit_options[0].value,
                options = temp_unit_options,
            ),
            schema.Dropdown(
                id = "debug_weather",
                name = "Debug Weather Override",
                desc = "Force a specific Lulu & Lumei animation state for local testing.",
                icon = "bug",
                default = debug_weather_options[0].value,
                options = debug_weather_options,
            ),
        ],
    )
