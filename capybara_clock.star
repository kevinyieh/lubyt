# ---------------------------------------------------------------------------
# Helper Functions
# ---------------------------------------------------------------------------
def round_int(val):
    """Pure Starlark nearest-integer rounding (handles positive & negative floats)."""
    if val >= 0:
        return int(val + 0.5)
    return int(val - 0.5)


def extract_hhmm(iso_timestamp):
    """Extract zero-padded 'HH:MM' from an Open-Meteo ISO string like '2026-11-26T16:30'."""
    if not iso_timestamp or "T" not in iso_timestamp:
        return ""
    parts = iso_timestamp.split("T")
    if len(parts) < 2 or len(parts[1]) < 5:
        return ""
    return parts[1][:5]


def geocode_zip(zip_code):
    """Resolve a zip/postal code via Open-Meteo Geocoding API (cached 24h)."""
    cleaned = zip_code.strip()
    if not cleaned:
        return None

    cache_key = "capybara_geo_" + cleaned.replace(" ", "_")
    cached = cache.get(cache_key)
    if cached != None:
        return json.decode(cached)

    url = (
        "https://geocoding-api.open-meteo.com/v1/search"
        + "?name=" + cleaned.replace(" ", "%20")
        + "&count=1&language=en&format=json"
    )
    resp = http.get(url, ttl_seconds = GEOCODE_CACHE_TTL_SECONDS)
    if resp.status_code != 200:
        return None

    body = resp.json()
    results = body.get("results")
    if not results or len(results) == 0:
        return None

    first = results[0]
    geo = {
        "lat": str(first.get("latitude", DEFAULT_LAT)),
        "lon": str(first.get("longitude", DEFAULT_LON)),
        "timezone": str(first.get("timezone", "")),
    }
    cache.set(cache_key, json.encode(geo), ttl_seconds = GEOCODE_CACHE_TTL_SECONDS)
    return geo


def resolve_location(config):
    """Resolve (lat, lon, timezone) from explicit coords, zip, Tidbyt picker, or defaults."""
    lat = (config.str("latitude") or "").strip()
    lon = (config.str("longitude") or "").strip()
    tz_override = (config.str("timezone") or "").strip()
    tz_from_loc = ""

    if not lat or not lon:
        zip_code = (config.str("zip_code") or "").strip()
        if zip_code:
            geo = geocode_zip(zip_code)
            if geo != None:
                lat = geo.get("lat", DEFAULT_LAT)
                lon = geo.get("lon", DEFAULT_LON)
                tz_from_loc = geo.get("timezone", "")

    if not lat or not lon:
        loc_raw = config.get("location")
        if loc_raw:
            loc = json.decode(loc_raw)
            if loc:
                lat = str(loc.get("lat", DEFAULT_LAT))
                lon = str(loc.get("lng", DEFAULT_LON))
                tz_from_loc = str(loc.get("timezone", ""))

    if not lat or not lon:
        lat = DEFAULT_LAT
        lon = DEFAULT_LON

    timezone = tz_override or tz_from_loc or config.get("$tz") or DEFAULT_TIMEZONE
    return lat, lon, timezone


def map_wmo_to_weather(wmo_code, wind_kmh):
    """
    Map EVERY official Open-Meteo WMO 4677 code + wind into one of 12 weather types:
      - 96, 99                 -> thunderstorm_hail
      - 95                     -> thunderstorm
      - 71, 73, 75, 77, 85, 86 -> snow
      - 56, 57, 66, 67         -> freezing_rain
      - 80, 81, 82             -> rain_showers
      - 61, 63, 65             -> rain
      - 51, 53, 55             -> drizzle
      - 45, 48                 -> fog
      - wind >= 25 km/h (dry)  -> windy
      - 3                      -> overcast
      - 2                      -> partly_cloudy
      - 0, 1                   -> clear
    """
    code = int(wmo_code)

    if code in (96, 99):
        return "thunderstorm_hail"
    if code == 95:
        return "thunderstorm"
    if code in (71, 73, 75, 77, 85, 86):
        return "snow"
    if code in (56, 57, 66, 67):
        return "freezing_rain"
    if code in (80, 81, 82):
        return "rain_showers"
    if code in (61, 63, 65):
        return "rain"
    if code in (51, 53, 55):
        return "drizzle"
    if code in (45, 48):
        return "fog"

    if wind_kmh >= WINDY_THRESHOLD_KMH:
        return "windy"

    if code == 3:
        return "overcast"
    if code == 2:
        return "partly_cloudy"
    return "clear"


def is_night_from_sun(now_hhmm, weather):
    """
    Switch between Day and Night animations using today's local sunrise & sunset
    fetched from Open-Meteo (`daily.sunrise[0]` and `daily.sunset[0]`).
    Falls back to `current.is_day` if sunrise/sunset aren't available.
    """
    if weather == None:
        return now_hhmm >= "18:00" or now_hhmm < "06:00"
    sunrise = weather.get("sunrise", "")
    sunset = weather.get("sunset", "")
    if sunrise and sunset:
        return now_hhmm >= sunset or now_hhmm < sunrise
    return int(weather.get("is_day", 1)) == 0


def fetch_weather(lat, lon, timezone, temp_unit):
    """
    Fetch current temperature, WMO weather code, wind speed, is_day, AND
    today's local sunrise & sunset times from Open-Meteo (cached 12 minutes).
    """
    unit_param = "celsius" if temp_unit == "C" else "fahrenheit"
    cache_key = "capybara_wx_v2_%s_%s_%s_%s" % (lat, lon, timezone.replace("/", "_"), temp_unit)

    cached_raw = cache.get(cache_key)
    if cached_raw != None:
        return json.decode(cached_raw)

    url = (
        "https://api.open-meteo.com/v1/forecast"
        + "?latitude=" + lat
        + "&longitude=" + lon
        + "&current=temperature_2m,weather_code,wind_speed_10m,is_day"
        + "&daily=sunrise,sunset"
        + "&forecast_days=1"
        + "&timezone=auto"
        + "&temperature_unit=" + unit_param
    )

    resp = http.get(url, ttl_seconds = WEATHER_CACHE_TTL_SECONDS)
    if resp.status_code != 200:
        return None

    data = resp.json()
    current = data.get("current")
    if not current:
        return None

    daily = data.get("daily") or {}
    sunrises = daily.get("sunrise") or []
    sunsets = daily.get("sunset") or []

    weather = {
        "temp": current.get("temperature_2m", 0.0),
        "code": current.get("weather_code", 0),
        "wind": current.get("wind_speed_10m", 0.0),
        "is_day": current.get("is_day", 1),
        "sunrise": extract_hhmm(sunrises[0]) if len(sunrises) > 0 else "",
        "sunset": extract_hhmm(sunsets[0]) if len(sunsets) > 0 else "",
        "timezone": str(data.get("timezone", "")),
    }
    cache.set(cache_key, json.encode(weather), ttl_seconds = WEATHER_CACHE_TTL_SECONDS)
    return weather


def is_cold_temp(weather, temp_unit):
    """Return True when live temperature is below 55°F (12.8°C)."""
    if weather == None:
        return False
    temp_val = float(weather.get("temp", 65.0))
    temp_f = (temp_val * 9.0 / 5.0 + 32.0) if temp_unit == "C" else temp_val
    return temp_f < COLD_THRESHOLD_F


def easter_month_day(year):
    """Exact Gregorian Easter Sunday (month, day) via Meeus/Jones/Butcher algorithm."""
    a = year % 19
    b = year // 100
    c = year % 100
    d = b // 4
    e = b % 4
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i = c // 4
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l) // 451
    month = (h + l - 7 * m + 114) // 31
    day = ((h + l - 7 * m + 114) % 31) + 1
    return month, day


def detect_special_day(year, month, day, weekday, now_24h):
    """
    Detect Birthdays & Major Holidays from local calendar date/time.
    Returns the matching sprite state key or None on regular weather days.
    """
    # Birthdays (highest priority!)
    if month == 2 and day == 20:
        return "birthday_lulu"
    if month == 10 and day == 20:
        return "birthday_lumei"

    # Fixed-date major holidays (plus New Year's Eve & Christmas Eve evenings)
    if (month == 1 and day == 1) or (month == 12 and day == 31 and now_24h >= "18:00"):
        return "holiday_new_year"
    if month == 2 and day == 14:
        return "holiday_valentines"
    if month == 3 and day == 17:
        return "holiday_st_patricks"
    if month == 7 and day == 4:
        return "holiday_independence"
    if month == 10 and day == 31:
        return "holiday_halloween"
    if (month == 12 and day == 25) or (month == 12 and day == 24 and now_24h >= "18:00"):
        return "holiday_christmas"

    # Floating holidays
    # Thanksgiving: 4th Thursday of November (day 22..28 on Thu)
    if month == 11 and weekday == "Thu" and day >= 22 and day <= 28:
        return "holiday_thanksgiving"

    # Easter Sunday
    e_month, e_day = easter_month_day(year)
    if month == e_month and day == e_day:
        return "holiday_easter"

    # Lunar New Year
    lny = LUNAR_NEW_YEAR_DATES.get(year)
    if lny != None and month == lny[0] and day == lny[1]:
        return "holiday_lunar_new_year"

    return None


def resolve_sprite_state(weather_type, is_night, is_cold):
    """Build final sprite key (adding _cold/_warm suffix for temperature-sensitive scenes)."""
    tod = "night" if is_night else "day"
    if weather_type in TEMP_AWARE_WEATHERS:
        tier = "cold" if is_cold else "warm"
        candidate = "%s_%s_%s" % (weather_type, tod, tier)
        if candidate in SPRITES_B64:
            return candidate
    candidate = "%s_%s" % (weather_type, tod)
    if candidate in SPRITES_B64:
        return candidate
    return "clear_night_warm" if is_night else "clear_day_warm"


# ---------------------------------------------------------------------------
# Main Render Entrypoint
# ---------------------------------------------------------------------------
def main(config):
    use_24h = config.bool("use_24h", False)
    temp_unit = config.str("temp_unit", DEFAULT_TEMP_UNIT)
    debug_weather = config.str("debug_weather", "auto")
    debug_tod = config.str("debug_time_of_day", "auto")
    debug_temp = config.str("debug_temp", "auto")
    debug_holiday = config.str("debug_holiday", "auto")
    tz_override = (config.str("timezone") or "").strip()

    # Optional pre-fetched weather JSON passed by CI (e.g. GitHub Actions 15-min cache)
    # so 1-minute clock pushes never stall or fail on transient Open-Meteo timeouts.
    weather_json_raw = (config.str("weather_json") or "").strip()
    if weather_json_raw:
        weather = None if weather_json_raw == "none" else json.decode(weather_json_raw)
        weather_tz = weather.get("timezone", "") if weather != None else ""
        timezone = tz_override or weather_tz or config.get("$tz") or DEFAULT_TIMEZONE
    else:
        lat, lon, timezone = resolve_location(config)
        # Live weather + today's sunrise/sunset + exact local timezone from Open-Meteo
        weather = fetch_weather(lat, lon, timezone, temp_unit)

        # Prefer explicit user timezone override; otherwise use Open-Meteo's auto-detected
        # IANA timezone for (lat, lon) so the displayed clock always matches your coordinates.
        if not tz_override and weather != None and weather.get("timezone"):
            timezone = weather.get("timezone")

    # Current local time (optional clock_offset_sec lets automated CI pre-render
    # the upcoming minute ~15s early so Tidbyt flips right at :00!)
    clock_offset_sec = int(config.str("clock_offset_sec", "0") or "0")
    now_utc = time.now()
    if clock_offset_sec != 0:
        now_utc = now_utc + time.parse_duration("%ds" % clock_offset_sec)
    now = now_utc.in_location(timezone)
    now_24h = now.format("15:04")
    time_str = now_24h if use_24h else now.format("3:04")

    if weather != None:
        temp_str = "%d°" % round_int(weather["temp"])
        weather_type = map_wmo_to_weather(weather["code"], weather["wind"])
    else:
        temp_str = "--°"
        weather_type = "clear"

    # Determine Day vs Night based on today's local sunset & sunrise
    if debug_tod == "day":
        is_night = False
    elif debug_tod == "night":
        is_night = True
    else:
        is_night = is_night_from_sun(now_24h, weather)

    # Determine Warm vs Cold (< 55°F / 12.8°C) for temperature-sensitive activities
    if debug_temp == "cold":
        is_cold = True
    elif debug_temp == "warm":
        is_cold = False
    else:
        is_cold = is_cold_temp(weather, temp_unit)

    # Determine active state: debug_holiday -> debug_weather -> auto birthday/holiday -> live weather
    if debug_holiday != "auto" and debug_holiday != "none" and debug_holiday in SPRITES_B64:
        state = debug_holiday
        color_key = state
    elif debug_weather != "auto":
        if debug_weather in SPRITES_B64:
            state = debug_weather
            color_key = debug_weather if debug_weather in HUD_TEMP_COLORS else debug_weather.split("_day")[0].split("_night")[0]
        else:
            weather_type = debug_weather
            state = resolve_sprite_state(weather_type, is_night, is_cold)
            color_key = weather_type
    else:
        special = None
        if debug_holiday != "none":
            special = detect_special_day(now.year, now.month, now.day, now.format("Mon"), now_24h)
        if special != None and special in SPRITES_B64:
            state = special
            color_key = special
        else:
            state = resolve_sprite_state(weather_type, is_night, is_cold)
            color_key = weather_type

    print("CapybaraClock:", time_str, "| tz=", timezone, "| temp=", temp_str, "| state=", state)

    temp_color = HUD_TEMP_COLORS.get(color_key, "#FDE047")
    sprite_bytes = base64.decode(SPRITES_B64[state])

    # Ultra-minimal Upper-Left Corner HUD (Time + Temp only, no F/C, tight 20x12 px at 0,0)
    corner_hud = render.Box(
        width = 20,
        height = 12,
        color = "#05091499",
        child = render.Padding(
            pad = (1, 1, 0, 0),
            child = render.Column(
                cross_align = "start",
                children = [
                    render.Text(
                        content = time_str,
                        font = "tom-thumb",
                        color = "#FFFFFF",
                    ),
                    render.Text(
                        content = temp_str,
                        font = "tom-thumb",
                        color = temp_color,
                    ),
                ],
            ),
        ),
    )

    return render.Root(
        delay = SPRITE_DELAY_MS,
        show_full_animation = True,
        max_age = 3600,
        child = render.Stack(
            children = [
                render.Image(
                    src = sprite_bytes,
                    width = SPRITE_WIDTH,
                    height = SPRITE_HEIGHT,
                ),
                corner_hud,
            ],
        ),
    )


# ---------------------------------------------------------------------------
# Pixlet Configuration Schema
# ---------------------------------------------------------------------------
def get_schema():
    temp_unit_options = [
        schema.Option(display = "Fahrenheit", value = "F"),
        schema.Option(display = "Celsius", value = "C"),
    ]

    debug_weather_options = [
        schema.Option(display = "Auto (Live Weather)", value = "auto"),
        schema.Option(display = "Clear (WMO 0-1: Watermelon / Stargazing)", value = "clear"),
        schema.Option(display = "Partly Cloudy (WMO 2: Picnic Heist)", value = "partly_cloudy"),
        schema.Option(display = "Overcast (WMO 3: Sleepy Cuddle)", value = "overcast"),
        schema.Option(display = "Fog / Rime Fog (WMO 45, 48: Fog Hide & Seek)", value = "fog"),
        schema.Option(display = "Drizzle (WMO 51-55: Puddle Splashes)", value = "drizzle"),
        schema.Option(display = "Freezing Rain (WMO 56-57, 66-67: Ice Slide)", value = "freezing_rain"),
        schema.Option(display = "Rain (WMO 61-65: Umbrella Tug-of-War)", value = "rain"),
        schema.Option(display = "Rain Showers (WMO 80-82: Rainbow / Moonbow)", value = "rain_showers"),
        schema.Option(display = "Snow (WMO 71-77, 85-86: Snowball Fight)", value = "snow"),
        schema.Option(display = "Thunderstorm (WMO 95: Blanket Leap)", value = "thunderstorm"),
        schema.Option(display = "Thunderstorm + Hail (WMO 96, 99: Hail Shield)", value = "thunderstorm_hail"),
        schema.Option(display = "Windy (>= 25 km/h: Blown Off-Screen!)", value = "windy"),
    ]

    debug_tod_options = [
        schema.Option(display = "Auto (Today's Sunrise / Sunset)", value = "auto"),
        schema.Option(display = "Force Day", value = "day"),
        schema.Option(display = "Force Night", value = "night"),
    ]

    debug_temp_options = [
        schema.Option(display = "Auto (Live Temp: Cold < 55°F / Warm >= 55°F)", value = "auto"),
        schema.Option(display = "Force Warm (Ice Cream / Summer Picnic)", value = "warm"),
        schema.Option(display = "Force Cold (Hot Cocoa / Campfire / Warm Buns)", value = "cold"),
    ]

    debug_holiday_options = [
        schema.Option(display = "Auto (Birthdays & Major Holidays)", value = "auto"),
        schema.Option(display = "Disable Holidays (Weather Only)", value = "none"),
        schema.Option(display = "New Year's (Dec 31 Eve / Jan 1)", value = "holiday_new_year"),
        schema.Option(display = "Lunar New Year", value = "holiday_lunar_new_year"),
        schema.Option(display = "Valentine's Day (Feb 14)", value = "holiday_valentines"),
        schema.Option(display = "Lulu's Birthday (Feb 20)", value = "birthday_lulu"),
        schema.Option(display = "St. Patrick's Day (Mar 17)", value = "holiday_st_patricks"),
        schema.Option(display = "Easter Sunday", value = "holiday_easter"),
        schema.Option(display = "Independence Day (Jul 4)", value = "holiday_independence"),
        schema.Option(display = "Lumei's Birthday (Oct 20)", value = "birthday_lumei"),
        schema.Option(display = "Halloween (Oct 31)", value = "holiday_halloween"),
        schema.Option(display = "Thanksgiving (4th Thu Nov)", value = "holiday_thanksgiving"),
        schema.Option(display = "Christmas (Dec 24 Eve / Dec 25)", value = "holiday_christmas"),
    ]

    return schema.Schema(
        version = "1",
        fields = [
            schema.Location(
                id = "location",
                name = "Location",
                desc = "Select your city for live local weather, sunrise/sunset, and timezone.",
                icon = "locationDot",
            ),
            schema.Text(
                id = "latitude",
                name = "Latitude (Optional Override)",
                desc = "Manual latitude (e.g., 40.6782). Overrides Location picker when paired with Longitude.",
                icon = "compass",
            ),
            schema.Text(
                id = "longitude",
                name = "Longitude (Optional Override)",
                desc = "Manual longitude (e.g., -73.9442). Overrides Location picker when paired with Latitude.",
                icon = "compass",
            ),
            schema.Text(
                id = "zip_code",
                name = "Zip / Postal Code (Optional)",
                desc = "Alternative to Lat/Lon (e.g., 11215). Resolved via Open-Meteo Geocoding.",
                icon = "mapPin",
            ),
            schema.Text(
                id = "timezone",
                name = "Timezone (Optional Override)",
                desc = "IANA timezone name (e.g., America/New_York, America/Los_Angeles).",
                icon = "clock",
            ),
            schema.Toggle(
                id = "use_24h",
                name = "24-Hour Clock",
                desc = "Display time in 24-hour format (HH:MM) instead of 12-hour format.",
                icon = "clock",
                default = False,
            ),
            schema.Dropdown(
                id = "temp_unit",
